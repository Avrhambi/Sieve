#!/usr/bin/env python3
"""bin/sieve-hook — Claude Code interceptor hook (UserPromptSubmit / PostCompact).

Performance contract: <50ms total elapsed.  All src.* imports are deferred
behind the daemon-alive guard so the fast offline fallback path stays pure
stdlib.  The heartbeat check and file-tree heuristic use zero third-party code.
"""
# ── Timer starts before any import ──────────────────────────────────────────
import time as _t
_t0 = _t.perf_counter()

import os
import sys
import io

# Force UTF-8 stdout/stderr so non-ASCII characters (e.g. ✓) don't crash on
# Windows terminals with non-Unicode code pages (cp1255, cp1252, etc.).
if hasattr(sys.stdout, 'buffer'):
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
if hasattr(sys.stderr, 'buffer'):
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')
import sqlite3
import argparse
from pathlib import Path

# ---------------------------------------------------------------------------
# WSL2 detection
# ---------------------------------------------------------------------------
def _is_wsl2() -> bool:
    try:
        return "microsoft" in open("/proc/version").read().lower()
    except OSError:
        return False

# ---------------------------------------------------------------------------
# Constants (mirror src.daemon.heartbeat without importing it)
# ---------------------------------------------------------------------------
_STALE_THRESHOLD = 30.0          # seconds — matches STALE_THRESHOLD in heartbeat.py
_HEARTBEAT_TIMEOUT = 0.3         # sqlite timeout for heartbeat read (seconds)
_REPO_ROOT = Path(__file__).resolve().parent.parent
_DB_PATH = Path.cwd().resolve() / "ledger.db"
_SOURCE_EXTS = frozenset({".py", ".js", ".ts", ".tsx", ".jsx"})
_IMG_EXTS = frozenset({".png", ".jpg", ".jpeg", ".bmp", ".tiff", ".tif"})

# ---------------------------------------------------------------------------
# Arg parsing
# ---------------------------------------------------------------------------
_ap = argparse.ArgumentParser(add_help=False)
_ap.add_argument("--mode", default="prompt", choices=["prompt", "compact"])
_args, _ = _ap.parse_known_args()

# ---------------------------------------------------------------------------
# @full[path] bypass — inject file contents and exit 0
# ---------------------------------------------------------------------------
_stdin_prompt_cache: str | None = None

def _read_stdin_prompt() -> str:
    """Read prompt text from stdin — works on Windows (no select needed). Cached."""
    global _stdin_prompt_cache
    if _stdin_prompt_cache is not None:
        return _stdin_prompt_cache
    if sys.stdin.isatty():
        _stdin_prompt_cache = ""
        return ""
    try:
        import json as _j
        data = sys.stdin.buffer.read()
        try:
            _stdin_prompt_cache = _j.loads(data).get("prompt", "")
        except Exception:
            _stdin_prompt_cache = data.decode("utf-8", errors="replace")
    except Exception:
        _stdin_prompt_cache = ""
    return _stdin_prompt_cache


def _check_full_bypass() -> None:
    prompt = None
    env_prompt = os.environ.get("SIEVE_PROMPT", "")
    if env_prompt.startswith("@full"):
        prompt = env_prompt
    elif not sys.stdin.isatty():
        candidate = _read_stdin_prompt()
        if candidate.lstrip().startswith("@full"):
            prompt = candidate.lstrip()
    if prompt is not None and prompt.startswith("@full"):
        # Take only the first token after @full— ignore any trailing question text.
        file_path = prompt[len("@full"):].split()[0] if prompt[len("@full"):].strip() else ""
        _FULL_MAX_KB = 50
        try:
            size_kb = os.path.getsize(file_path) / 1024
            if size_kb > _FULL_MAX_KB:
                print(f"[sieve] @full: {file_path!r} is {size_kb:.0f}KB — limit is {_FULL_MAX_KB}KB. Use a specific line range or the skeleton instead.", file=sys.stderr)
            else:
                with open(file_path, "r", errors="replace") as fh:
                    contents = fh.read()
                print(f"### {file_path}")
                print(contents)
        except OSError as e:
            print(f"[sieve] @full: could not read {file_path!r}: {e}", file=sys.stderr)
        exit(0)


_check_full_bypass()

# ---------------------------------------------------------------------------
# Daemon liveness — raw sqlite3, no src.* import
# ---------------------------------------------------------------------------
def _daemon_alive() -> bool:
    """Return True iff the heartbeat row exists and is fresher than 30 s."""
    try:
        conn = sqlite3.connect(str(_DB_PATH), timeout=_HEARTBEAT_TIMEOUT)
        try:
            # Skip WAL pragma here — we only read, and the daemon owns WAL setup.
            row = conn.execute(
                "SELECT ts FROM daemon_heartbeat WHERE id = 1"
            ).fetchone()
        finally:
            conn.close()
        if row is None:
            return False
        return (_t.time() - row[0]) < _STALE_THRESHOLD
    except Exception:
        return False

# ---------------------------------------------------------------------------
# File-tree heuristic fallback — pure stdlib, no src.* imports
# ---------------------------------------------------------------------------
def _file_tree_fallback(max_depth: int = 3) -> str:
    """Walk cwd up to max_depth with os.scandir (faster than Path.iterdir).

    On WSL2, os.scandir crosses the Windows filesystem boundary (150-250ms).
    Tries a SQLite fast-path first using the ledger WAL memory.
    """
    cwd = Path.cwd().resolve()
    cwd_str = str(cwd)

    # On WSL2, os.scandir crosses the Windows filesystem boundary (150-250ms).
    # Read from SQLite instead — it's already in WAL memory.
    _used_sqlite_fallback = False
    if _is_wsl2():
        try:
            import sqlite3 as _sqlite3
            _db_path = str(Path(__file__).parent.parent / "ledger.db")
            _fc = _sqlite3.connect(_db_path)
            _fc.execute("PRAGMA journal_mode=WAL")
            _fc.execute("PRAGMA busy_timeout=500")
            _rows = _fc.execute(
                "SELECT path FROM ledger WHERE path LIKE ? AND is_ignored=0 ORDER BY path",
                (str(cwd) + "/%",)
            ).fetchall()
            _fc.close()
            if _rows:
                print("[sieve] daemon offline — ledger heuristic (WSL2)")
                for (_p,) in _rows:
                    print(f"  {_p}")
                _used_sqlite_fallback = True
        except Exception:
            pass  # fall through to scandir

    if not _used_sqlite_fallback:
        max_depth = _load_max_depth()
        lines = ["[sieve] daemon offline — file-tree heuristic", ""]

        def _walk(d: str, depth: int) -> None:
            if depth > max_depth:
                return
            try:
                entries = sorted(os.scandir(d), key=lambda e: e.name)
            except OSError:
                return
            for e in entries:
                if e.name.startswith("."):
                    continue
                if e.is_dir(follow_symlinks=False):
                    _walk(e.path, depth + 1)
                elif os.path.splitext(e.name)[1] in _SOURCE_EXTS:
                    rel = e.path[len(cwd_str) + 1:] if e.path.startswith(cwd_str) else e.path
                    lines.append(f"  {rel}")

        _walk(cwd_str, 0)
        return "\n".join(lines)

    return ""

# ---------------------------------------------------------------------------
# Config loader — reads TOML with stdlib (no pydantic / toml dep on this path)
# ---------------------------------------------------------------------------
def _load_max_depth() -> int:
    """Read MAX_DEPTH from config without importing src.main."""
    try:
        import tomllib  # stdlib in Python 3.11+
        cfg_path = _REPO_ROOT / "config" / "sieve.config.toml"
        with open(cfg_path, "rb") as fh:
            raw = tomllib.load(fh)
        return int(raw["thresholds"]["MAX_DEPTH"])
    except Exception:
        return 3  # matches config default

def _compact_skeleton() -> str:
    """Re-inject the pre-built architectural map (PostCompact mode).

    Reads a single row from the architecture_map table — always <2KB,
    always fits Claude Code's inline injection limit, <5ms.
    """
    if str(_REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(_REPO_ROOT))

    from src.data.ledger import Ledger, LedgerError, set_db_path  # noqa: PLC0415
    set_db_path(_DB_PATH)

    project = Path.cwd().resolve().as_posix()
    try:
        with Ledger() as ledger:
            arch_map = ledger.get_architecture_map(project)
            if arch_map:
                return arch_map
            # Fallback: map not yet built — return file-tree heuristic.
            return _file_tree_fallback()
    except LedgerError as exc:
        return f"[sieve] ledger locked — architectural map unavailable ({exc})"
    except Exception as exc:
        return f"[sieve] ledger error — architectural map unavailable ({exc})"

# ---------------------------------------------------------------------------
# Image cache processing — deferred import
# ---------------------------------------------------------------------------
def _process_images() -> str:
    """Extract text from images in ~/.claude/image-cache/ and toast them."""
    image_cache = Path.home() / ".claude" / "image-cache"
    if not image_cache.exists():
        return ""
    images = [f for f in image_cache.iterdir() if f.suffix.lower() in _IMG_EXTS]
    if not images:
        return ""

    if str(_REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(_REPO_ROOT))

    try:
        from src.visual.ocr_pipeline import extract_text  # noqa: PLC0415
        from src.visual.toaster import to_toast  # noqa: PLC0415
    except Exception:
        return ""

    toasts: list[str] = []
    for img in images:
        text = extract_text(img)
        toast = to_toast(text)
        if toast and toast != "(no content)":
            toasts.append(f"[image: {img.name}]\n{toast}")
    return "\n\n".join(toasts)

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    parts: list[str] = []

    alive = _daemon_alive()

    if _args.mode == "compact":
        if alive:
            parts.append(_compact_skeleton())
        else:
            parts.append(_file_tree_fallback())
    else:
        # UserPromptSubmit — inject only when daemon is offline (orientation fallback).
        # Active search is handled by the MCP server (sieve_find / sieve_file).
        if not alive:
            parts.append(_file_tree_fallback())

    img = _process_images()
    if img:
        parts.append(img)

    output = "\n\n".join(p for p in parts if p)
    if output:
        print(output)

    elapsed_ms = (_t.perf_counter() - _t0) * 1000
    if elapsed_ms > 40:
        print(f"[sieve] WARN: hook took {elapsed_ms:.1f}ms (limit 50ms)", file=sys.stderr)


if __name__ == "__main__":
    main()
